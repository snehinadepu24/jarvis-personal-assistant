# JARVIS Environment Configuration Example
# Copy this file to .env and fill in your keys

# Google Gemini API Key (Get free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary LLM Model (gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend mode: 'auto' (Windows UIA live desktop), 'mock' (simulated desktop for tests)
JARVIS_BACKEND=auto

# Server host and port
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# Safety Gate settings
JARVIS_GATE_TIMEOUT_S=30.0
JARVIS_GATE_CANCEL_WINDOW_S=2.0

